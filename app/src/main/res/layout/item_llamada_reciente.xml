<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Imagen redondeada -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgFotoReciente"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/user"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Custom.Full" />

    <!-- Nombre/Teléfono y Fecha -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreTelefonoReciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="+52 492 123 4567" />

        <TextView
            android:id="@+id/tvFechaLlamada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#757575"
            android:textSize="13sp"
            tools:text="Ayer, 4:15 PM" />
    </LinearLayout>

    <!-- Icono Teléfono -->
    <ImageView
        android:id="@+id/btnLlamarAudioReciente"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Llamada de audio"
        android:src="@android:drawable/ic_menu_call"
        app:tint="#075E54" />

    <!-- Icono Videocámara -->
    <ImageView
        android:id="@+id/btnLlamarVideoReciente"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Videollamada"
        android:src="@drawable/ic_videocam"
        app:tint="#075E54" />

</LinearLayout>