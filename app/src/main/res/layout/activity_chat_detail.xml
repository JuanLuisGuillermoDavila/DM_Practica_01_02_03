<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ChatDetailActivity">

    <!-- 1. Encabezado / Toolbar del Chat -->
    <LinearLayout
        android:id="@+id/toolbarChat"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#075E54"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Botón Regresar -->
        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regresar"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <!-- Foto de perfil -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPerfilChatDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/user"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Custom.Full" />

        <!-- Contenedor de Nombre y Estado (En línea / Última vez) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre de usuario -->
            <TextView
                android:id="@+id/tvNombreContactoDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Carlos Gómez" />

            <!-- Estado: en línea / última vez hoy a las... -->
            <TextView
                android:id="@+id/tvEstadoContactoDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="en línea"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                tools:text="en línea" />
        </LinearLayout>

        <!-- Icono Videollamada -->
        <ImageView
            android:id="@+id/btnVideoLlamadaChat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Videollamada"
            android:src="@drawable/ic_videocam"
            app:tint="#FFFFFF" />

        <!-- Icono Llamada -->
        <ImageView
            android:id="@+id/btnLlamadaChat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Llamada"
            android:src="@android:drawable/ic_menu_call"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 2. Barra inferior para escribir mensaje -->
    <LinearLayout
        android:id="@+id/barEscribirMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#F0F0F0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/etMensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/white"
            android:hint="Escribe un mensaje..."
            android:padding="10dp"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnEnviar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Enviar"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#075E54" />
    </LinearLayout>

    <!-- 3. Fondo / Área de mensajes -->
    <View
        android:id="@+id/areaMensajes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/barEscribirMensaje"
        android:layout_below="@id/toolbarChat"
        android:background="#E5DDD5" />

</RelativeLayout>